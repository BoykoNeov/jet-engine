+/// RUNG 103 (probe): the below-idle refusal.
+pub fn sub_idle(tt4: f64, sp: f64) -> Abort {
+    Abort(format!("rung-103: below idle at Tt4={tt4:.0}: with the nozzle unchoked the engine makes more drag than \
+                   thrust here (net {sp:.1} N per kg/s of air)"))
+}
