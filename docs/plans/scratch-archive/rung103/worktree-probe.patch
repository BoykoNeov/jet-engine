+/// RUNG-103 CENSUS (scratch worktree only): one line per unchoked refusal, written in ONE call.
+pub fn census_unchoke(site: &str, tt4: f64, m0: f64, p0: f64) {
+    if let Ok(path) = std::env::var("R103_CENSUS") {
+        use std::io::Write;
+        let exe = std::env::current_exe().ok().and_then(|p| p.file_stem().map(|s| s.to_string_lossy().into_owned()))
+            .unwrap_or_default();
+        let th = std::thread::current().name().unwrap_or("?").to_string();
+        let line = format!("{site}\t{tt4:.3}\t{m0:.4}\t{p0:.1}\t{exe}\t{th}\n");
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = f.write_all(line.as_bytes());
+        }
+    }
+}
