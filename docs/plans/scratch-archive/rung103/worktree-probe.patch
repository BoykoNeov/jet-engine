+/// RUNG 103 (probe): clears `lp_ctx` on every exit, panics included.
+pub struct BranchGuard<'a>(pub &'a TwoSpoolCore);
+impl Drop for BranchGuard<'_> {
+    fn drop(&mut self) { self.0.lp_ctx.set(None) }
 }
 
 impl TwoSpoolCore {
+    /// RUNG 103 (probe): the LP turbine in a steady cascade — rung 38's pin unless a below-choke re-solve runs.
+    pub fn try_lp_steady(
+        &self, gas: &Gas, tt45: f64, f45: f64, eta_lpt: f64, pi_hpt: f64,
+    ) -> Result<(f64, f64, f64), Abort> {
+        if let Some(pi) = self.fixed_pi.get() { let (t, t5) = self.try_tau_of(gas, tt45, f45, pi, eta_lpt)?; return Ok((pi, t, t5)); }
+        match self.lp_ctx.get() {
+            None => self.try_solve_choked_turbine(gas, tt45, f45, self.a45, self.a8, self.pi_n, eta_lpt),
+            Some((pt4, p0)) => crate::unchoked_lp::try_lp_turbine(self, gas, tt45, f45, eta_lpt, pi_hpt * pt4, p0),
+        }
+    }
+    /// RUNG 103 (probe): a joint loop's pass records its `pt4` while a re-solve runs.
+    pub fn track_pt4(&self, pt4: f64) {
+        if let Some((_, p0)) = self.lp_ctx.get() { self.lp_ctx.set(Some((pt4, p0))) }
+    }
+    /// RUNG 103 (probe): at an unchoked guard — `Some(result)` of the re-solve when the switch is on and none runs yet.
+    pub fn below_choke_resolve<T>(
+        &self, p0: f64, tt4: f64, rerun: impl FnOnce() -> Result<T, Abort>, thrust: impl Fn(&T) -> f64,
+    ) -> Option<Result<T, Abort>> {
+        if !self.below_choke.get() || self.lp_ctx.get().is_some() { return None }
+        self.lp_ctx.set(Some((f64::NAN, p0)));
+        let g = BranchGuard(self);
+        let r = rerun();
+        drop(g);
+        Some(r.and_then(|x| { let t = thrust(&x); if t > 0.0 { Ok(x) } else { Err(sub_idle(tt4, t)) } }))
+    }
+    /// RUNG 103 (probe): inside a re-solve, the core's own specific thrust must be positive before scoring.
+    pub fn check_sub_idle(&self, tt4: f64, sp: f64) -> Result<(), Abort> {
+        if self.lp_ctx.get().is_some() && !(sp > 0.0) { Err(sub_idle(tt4, sp)) } else { Ok(()) }
+    }
+    pub fn in_branch(&self) -> bool { self.lp_ctx.get().is_some() || self.guard_off.get() || self.fixed_pi.get().is_some() }
+
     pub const TOL: f64 = 1e-13;
     pub const MAX: usize = 200;
 
