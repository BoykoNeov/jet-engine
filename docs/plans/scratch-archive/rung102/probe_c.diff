+
+// =============================================================================================
+// PART C PROBE — the afterburner on the two-shaft Controls plant (a hook, set per derivative)
+// =============================================================================================
+
+/// The afterburner fitted to the two-shaft plant at one instant: `w` is the light-off fraction (0 unlit, 1 fully
+/// lit); the burning temperature and the throat follow it from their unlit values.
+#[derive(Clone, Copy, Debug)]
+pub struct LpAb {
+    pub ab: Afterburner,
+    pub a6: f64,
+    pub a8_dry: f64,
+    /// The throat at full light over the dry throat (`Throat::Held`), or matched.
+    pub throat: Throat,
+    pub w: f64,
+}
+
+thread_local! {
+    static LP_AB: std::cell::Cell<Option<LpAb>> = const { std::cell::Cell::new(None) };
+    pub static LP_CALLS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+    pub static LP_TRIALS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+    pub static EXIT_CALLS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+pub fn lp_ab() -> Option<LpAb> { LP_AB.with(|c| c.get()) }
+pub fn set_lp_ab(x: Option<LpAb>) { LP_AB.with(|c| c.set(x)) }
+pub fn set_lp_w(w: f64) { LP_AB.with(|c| if let Some(mut x) = c.get() { x.w = w; c.set(Some(x)) }) }
+
+impl LpAb {
+    /// Fit to a two-shaft core: `A6` from the design run's station 5 at the `M6` knob, the dry throat `a8/π_fh`.
+    pub fn capture(base: &crate::two_spool::TwoSpoolCore, ab: Afterburner, throat: Throat) -> Self {
+        let s5 = base.reference.station("5");
+        let a6 = if ab.m6 == 0.0 { f64::INFINITY } else { area_at_mach(base.gas(), s5.far, s5.tt, s5.pt, s5.mdot, ab.m6) };
+        LpAb { ab, a6, a8_dry: base.a8 / ab.pi_fh, throat, w: 0.0 }
+    }
+    pub fn lit(&self) -> bool { self.w > 0.0 }
+    /// The throat now, m²: dry, opening with the light-off to its setting (matched: `None`, sized at the point).
+    pub fn a8_now(&self) -> Option<f64> {
+        match self.throat {
+            Throat::Held(s) => Some(self.a8_dry * (1.0 + self.w * (s - 1.0))),
+            Throat::Match => None,
+        }
+    }
+    pub fn tt7_at(&self, tt5: f64) -> f64 { tt5 + self.w * (self.ab.tt7 - tt5) }
+
+    /// Station 5 -> 7, lit, at `s5` (gas mass flow `s5.mdot`).
+    pub fn burn(&self, gas: &Gas, s5: &FlowState, name: bool) -> Result<(FlowState, AbDetail), Abort> {
+        LP_TRIALS.with(|c| c.set(c.get() + 1));
+        let m6 = m6_in_duct(gas, s5.far, s5.tt, s5.pt, s5.mdot, self.a6, self.ab.m6, name)?;
+        let ab = Afterburner { tt7: self.tt7_at(s5.tt), m6, ..self.ab };
+        afterburn(gas, s5, s5, s5.mdot / (1.0 + s5.far), &ab, AbMode::Lit, name)
+    }
+}
+
+/// The LP turbine with the afterburner fitted: unlit (or matched) the shipped relation through the dry throat with the
+/// flame holders' loss in the nozzle's; lit and held, (★AB) one throat downstream of `A45`, else the subsonic root.
+#[allow(clippy::too_many_arguments)]
+pub fn try_lp_turbine_ab(
+    base: &crate::two_spool::TwoSpoolCore, gas: &Gas, tt45: f64, f45: f64, eta: f64, pt45: f64, p0: f64, x: &LpAb,
+) -> Result<(f64, f64, f64), Abort> {
+    let unlit = || crate::unchoked_lp::try_lp_turbine_with(base, gas, tt45, f45, eta, pt45, p0, x.a8_dry,
+                                                           base.pi_n * x.ab.pi_fh);
+    let Some(a8) = x.a8_now().filter(|_| x.lit()) else { return unlit() };
+    let mfp45 = try_choked_mfp(gas, tt45, f45)?;
+    let mdot5 = base.a45 * pt45 * mfp45 / powp(tt45, 0.5);
+    let trial = |pi: f64| -> Result<(f64, f64, FlowState, FlowState, AbDetail), Abort> {
+        let (tau, tt5) = base.try_tau_of(gas, tt45, f45, pi, eta)?;
+        let s5 = FlowState { tt: tt5, pt: pi * pt45, mdot: mdot5, far: f45 };
+        let (s7, d) = x.burn(gas, &s5, false)?;
+        Ok((tau, tt5, s5, s7, d))
+    };
+    let rhs = base.a45 * mfp45 / ((1.0 + f45) * a8 * base.pi_n);
+    let resid = |pi: f64| -> Result<f64, Abort> {
+        let (_, _, _, s7, d) = trial(pi)?;
+        Ok(pi * d.pi_ab * powp(tt45 / s7.tt, 0.5) - rhs * (1.0 + s7.far) / try_choked_mfp(gas, s7.tt, s7.far)?)
+    };
+    let (lo, flo, hi, fhi) = bracket_in(&resid, 0.02, 0.999, 0.01)?;
+    if !(flo < 0.0 && 0.0 < fhi) {
+        return Err(Abort(format!("rung-102 LP turbine choke-match bracket does not straddle the root \
+                                  (pi_t {lo:.2}: {flo:.3e}, {hi:.3}: {fhi:.3e})")));
+    }
+    let pi_c = try_illinois(resid, lo, hi, flo, fhi, SpoolTransient::HOT_TOL, ILLINOIS_MAXIT)?;
+    let (tau, tt5, _, s7, _) = trial(pi_c)?;
+    let nozzle = Nozzle::convergent(p0, base.pi_n);
+    if nozzle.try_apply(&s7, gas)?.p9 > p0 + 1e-6 {
+        return Ok((pi_c, tau, tt5));
+    }
+    let sub = |pi: f64| -> Result<f64, Abort> {
+        let (_, _, _, s7, _) = trial(pi)?;
+        let e = nozzle.try_apply(&s7, gas)?;
+        Ok(s7.mdot - a8 * e.p9 / (gas.r_t_at(s7.far) * e.t9) * e.v9)
+    };
+    let (lo, rlo) = (pi_c, sub(pi_c)?);
+    let mut hi = crate::unchoked_lp::PI_TOP;
+    let rhi = loop {
+        match sub(hi) {
+            Ok(r) => break r,
+            Err(e) if hi - 0.01 <= lo => return Err(e),
+            Err(_) => hi -= 0.01,
+        }
+    };
+    if !(rlo > 0.0 && rhi < 0.0) {
+        if rlo <= 0.0 && rlo > -1e-9 * s7.mdot { return Ok((pi_c, tau, tt5)); }
+        return Err(Abort(format!("rung-102 LP subsonic turbine does not bracket ({rlo:.3e}, {rhi:.3e})")));
+    }
+    let pi = try_illinois(sub, lo, hi, rlo, rhi, SpoolTransient::HOT_TOL, ILLINOIS_MAXIT)?;
+    let (tau, tt5, _, _, _) = trial(pi)?;
+    Ok((pi, tau, tt5))
+}
+
+/// The nozzle exit behind the LP turbine, and the gas's fuel-air ratio there: the shipped nozzle when no afterburner is
+/// fitted (bit for bit), else through the afterburner at `s5` (`s5.mdot` the core AIR, as the tails pass it).
+pub fn lp_exit(base: &crate::two_spool::TwoSpoolCore, gas: &Gas, s5: &FlowState, p0: f64)
+    -> Result<(NozzleExit, f64), Abort>
+{
+    let Some(x) = lp_ab() else {
+        return Ok((Nozzle::convergent(p0, base.pi_n).try_apply(s5, gas)?, s5.far));
+    };
+    EXIT_CALLS.with(|c| c.set(c.get() + 1));
+    if !x.lit() {
+        let s7 = FlowState { pt: x.ab.pi_fh * s5.pt, ..*s5 };
+        return Ok((Nozzle::convergent(p0, base.pi_n).try_apply(&s7, gas)?, s5.far));
+    }
+    let g5 = FlowState { mdot: s5.mdot * (1.0 + s5.far), ..*s5 };
+    let (s7, _) = x.burn(gas, &g5, true)?;
+    Ok((Nozzle::convergent(p0, base.pi_n).try_apply(&s7, gas)?, s7.far))
+}
+
+thread_local! {
+    static LIGHT: std::cell::Cell<Option<(f64, f64)>> = const { std::cell::Cell::new(None) };
+}
+/// The light-off time and ramp duration (HP spool τ) the march's derivatives read their `w` from.
+pub fn set_light(x: Option<(f64, f64)>) { LIGHT.with(|c| c.set(x)) }
+pub fn light_w(s: f64) -> f64 {
+    match LIGHT.with(|c| c.get()) {
+        None => 0.0,
+        Some((s_on, tau)) => if s <= s_on + 1e-9 { 0.0 } else if tau <= 0.0 || s >= s_on + tau { 1.0 } else { (s - s_on) / tau },
+    }
+}
+/// Called at every derivative evaluation with its march time.
+pub fn tick(s: f64) { if LIGHT.with(|c| c.get()).is_some() { set_lp_w(light_w(s)) } }
+
+/// PROBE: a site the afterburner hook does not reach — panics while an afterburner is fitted.
+pub fn guard(site: &str) { if lp_ab().is_some_and(|x| x.lit()) { panic!("UNPATCHED {site}") } }
